                     try {
                         await this.initializeSupabaseSync();
                     } catch (e) {
                         console.error('[Supabase] Initial sync skipped:', e);
                     }
-                } else {
-                    console.warn('[Supabase] Client unavailable; continuing in local UI mode.');
                 }
                 this.$nextTick(() => {
                     this.updateCharts();
@@ -1875,6 +1871,7 @@
                     }
