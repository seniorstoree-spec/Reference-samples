                             .select('catalog,samples,deleted_samples,deleted_catalog,app_data_version').eq('id',1).maybeSingle();
@@ -2279,12 +2277,12 @@
                 },
                 async logout() {
                     try {
-                        await supabaseClient.auth.signOut();
+                        if (supabaseClient) await supabaseClient.auth.signOut();
                     } catch (e) {
                         console.error('[Auth] Sign-out error:', e);
                     }
-                    this.auth = { isAuthenticated: true, role: 'user', username: 'مستخدم مؤقت', email: null, error: '' };
