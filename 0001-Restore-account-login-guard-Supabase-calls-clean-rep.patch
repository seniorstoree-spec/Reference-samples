+                // Authentication is required. Resolve the stored Supabase session first.
                 try {
+                    if (!supabaseClient) throw new Error('Supabase client unavailable');
                     const { data: { session } } = await supabaseClient.auth.getSession();
                     if (session?.user) {
                         await this.applySupabaseUser(session.user);
                         this.appView = 'qc';
+                    } else {
+                        this.appView = 'login';
                     }
-                    supabaseClient.auth.onAuthStateChange(async (event, session) => {
-                        if (session?.user) {
-                            await this.applySupabaseUser(session.user);
-                        } else if (event === 'SIGNED_OUT') {
-                            // Authentication is temporarily bypassed; keep the application open.
-                            this.auth = { isAuthenticated: true, role: 'user', username: 'مستخدم مؤقت', email: null, error: '', loading: false };
-                            this.appView = 'qc';
+                    supabaseClient.auth.onAuthStateChange((event, session) => {
+                        if (event === 'SIGNED_OUT' || (!session && event !== 'INITIAL_SESSION')) {
+                            this.auth = { isAuthenticated: false, role: null, username: null, email: null, error: '', loading: false };
+                            this.appView = 'login';
                         }
                     });
                 } catch (e) {
                     console.error('[Auth] Session initialization failed:', e);
+                    this.appView = 'login';
+                    this.auth.error = this.lang === 'ar'
+                        ? 'تعذر الاتصال بخدمة تسجيل الدخول. تحقق من الإنترنت ثم أعد تحميل الصفحة.'
+                        : 'Could not reach the sign-in service. Check your connection and reload.';
                 }
                 // Migration: Sync all loaded samples with master catalog rules
                 let migrated = false;
@@ -1481,15 +1480,12 @@
                 this.$nextTick(() => {
                     this.updateCharts();
                 });
-                // Temporary no-login mode: the UI must remain usable even if Supabase is unavailable.
